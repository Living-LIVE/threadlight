# Runtime
# Use 0.0.0.0 when running in a container.
HOST=127.0.0.1
PORT=8787
# Local Vite development uses 5173; the container overrides this to 8787.
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Active development providers
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SCRIPTURE_PROVIDER=ao
AO_BIBLE_ID=BSB

# Discord
DISCORD_ENABLED=true
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_CARE_ROLE_ID=
DISCORD_REGISTER_COMMANDS=false

# Competition provider configuration
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=
GLOO_MODEL=
YVP_APP_KEY=
YVP_BIBLE_ID=
