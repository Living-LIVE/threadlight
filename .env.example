# Runtime
# Use 0.0.0.0 when running in a container.
HOST=127.0.0.1
PORT=8787
# Local Vite development uses 5173; the container overrides this to 8787.
WEB_ORIGIN=http://localhost:5173
# Public API origin for OAuth callbacks. Use the Railway or reverse-proxy URL when hosted.
THREADLIGHT_PUBLIC_URL=http://127.0.0.1:8787
# Required when THREADLIGHT_PUBLIC_URL is not loopback. Generate with: openssl rand -hex 32
THREADLIGHT_CONTROL_TOKEN=
# Remote anonymous demo requests are disabled by default to prevent provider abuse.
THREADLIGHT_DEMO_ENABLED=false
LOG_LEVEL=info
# Local development configuration store. Docker uses /data/threadlight.json.
THREADLIGHT_CONFIG_PATH=.threadlight/config.json

# Optional public API origin for a separately hosted dashboard, such as Vercel.
# Leave empty for the bundled dashboard or local Vite proxy.
VITE_THREADLIGHT_API_ORIGIN=

# Active development providers
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SCRIPTURE_PROVIDER=ao
AO_BIBLE_ID=BSB

# Discord
DISCORD_ENABLED=true
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_CARE_ROLE_ID=
DISCORD_REGISTER_COMMANDS=false
DISCORD_PARTICIPATION_MODE=shy
DISCORD_AMBIENT_QUIET_SECONDS=20
DISCORD_AMBIENT_COOLDOWN_SECONDS=180
DISCORD_MAX_QUEUE_DEPTH=25

# Competition provider configuration
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=
GLOO_MODEL=
YVP_APP_KEY=
YVP_BIBLE_ID=

# YouTube account connection. Configure once for this Threadlight installation;
# channel owners only sign in with Google through the dashboard.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
