{
  "name": "threadlight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Scripture-native presence for shared digital conversations.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --aggregate-output build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "concurrently -k -n server,web -c yellow,cyan \"pnpm --filter @threadlight/server dev\" \"pnpm --filter @threadlight/web dev\"",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --aggregate-output typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "26.1.1",
    "concurrently": "10.0.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
